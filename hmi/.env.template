# SCADA HMI — Environment Configuration
# Copy to .env and fill in your values.
# This file must NOT be committed to Git.

# ── Database (same values as Python logger) ─────────────────────────
DB_HOST=127.0.0.1
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=scada

# ── Alert channels ───────────────────────────────────────────────────

# Discord webhook URL (leave blank to disable)
DISCORD_WEBHOOK_URL=

# Email alert recipient (leave blank to disable)
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=you@example.com

# SMTP settings (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password_here
