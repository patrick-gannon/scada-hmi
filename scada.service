[Unit]
Description=SCADA Environment Logger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/bash -c '\
  echo "[$(date)] Starting SSH tunnels..." >> /tmp/scada.log; \
  \
  # MySQL tunnel
  for attempt in 1 2 3 4 5; do \
    if ssh -f -N -L 3306:127.0.0.1:3306 ${SSH_USER}@${SSH_HOST} 2>/tmp/ssh_error.log; then \
      echo "[$(date)] MySQL tunnel established (attempt $attempt)" >> /tmp/scada.log; \
      break; \
    else \
      echo "[$(date)] MySQL tunnel failed (attempt $attempt), retrying..." >> /tmp/scada.log; \
      sleep 5; \
    fi; \
    if [ $attempt -eq 5 ]; then \
      echo "[$(date)] FATAL: MySQL tunnel failed" >> /tmp/scada.log; \
      exit 1; \
    fi; \
  done; \
  \
  # Local controller tunnel (Pi port 8081 -> VPS port 8081)
  for attempt in 1 2 3 4 5; do \
    if ssh -f -N -R 8081:localhost:8081 ${SSH_USER}@${SSH_HOST} 2>/tmp/ssh_error.log; then \
      echo "[$(date)] Controller tunnel established (attempt $attempt)" >> /tmp/scada.log; \
      break; \
    else \
      echo "[$(date)] Controller tunnel failed (attempt $attempt), retrying..." >> /tmp/scada.log; \
      sleep 5; \
    fi; \
    if [ $attempt -eq 5 ]; then \
      echo "[$(date)] FATAL: Controller tunnel failed" >> /tmp/scada.log; \
      exit 1; \
    fi; \
  done; \
  sleep 2; \
  exit 0'
ExecStart=/usr/bin/python3 /home/patrick/scada-hmi/pi/log_environment.py
User=patrick
Restart=always
RestartSec=10
ExecStop=/bin/bash -c 'pkill -f "ssh -f -N -L 3306" || true; pkill -f "ssh -f -N -R 8081" || true'
RestartForceExitStatus=1

[Install]
WantedBy=multi-user.target
