[Unit]
Description=SCADA Environment Logger with SSH Tunnels
After=network.target local_controller.service
Wants=local_controller.service

[Service]
Type=simple
User=patrick
ExecStart=/home/patrick/scada-hmi/pi/scada_wrapper.sh
ExecStopPost=-/bin/bash -c 'pkill -f "ssh.*3306:127.0.0.1:3306" 2>/dev/null || true; pkill -f "ssh.*8081:localhost:8081" 2>/dev/null || true'
Restart=always
RestartSec=15
Environment="SSH_USER=pgannon"
Environment="SSH_HOST=69.48.207.60"

[Install]
WantedBy=multi-user.target