[Unit]
Description=SCADA Local Controller - Kasa Plug Control
After=network.target

[Service]
Type=simple
User=patrick
Group=patrick
WorkingDirectory=/home/patrick/scada-hmi/pi
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 /home/patrick/scada-hmi/pi/local_controller_simple.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
